# Entity: live_data

main: kit: entity: live_data: {

  alias: field: {}

  fields: [
    {
      name: "cities"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "country"
      req: false
      short: "Country code"
      type: "`$STRING`"
    }
    {
      name: "country_name"
      req: false
      short: "Full country name"
      type: "`$STRING`"
    }
    {
      name: "domain"
      req: false
      short: "Country domain"
      type: "`$STRING`"
    }
    {
      name: "hotline"
      req: false
      short: "Support hotline number"
      type: "`$STRING`"
    }
    {
      format: "double"
      name: "lat"
      req: false
      short: "Country center latitude"
      type: "`$NUMBER`"
    }
    {
      format: "double"
      name: "lng"
      req: false
      short: "Country center longitude"
      type: "`$NUMBER`"
    }
    {
      name: "name"
      req: false
      short: "Country name"
      type: "`$STRING`"
    }
    {
      name: "policy"
      req: false
      short: "Privacy policy URL"
      type: "`$STRING`"
    }
    {
      name: "terms"
      req: false
      short: "Terms and conditions URL"
      type: "`$STRING`"
    }
    {
      name: "website"
      req: false
      short: "Website URL"
      type: "`$STRING`"
    }
    {
      name: "zoom"
      req: false
      short: "Default zoom level"
      type: "`$INTEGER`"
    }
  ]

  name: "live_data"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "city"
                orig: "city"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 5000
                kind: "query"
                name: "distance"
                orig: "distance"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "lat"
                orig: "lat"
                reqd: false
                type: "`$NUMBER`"
              }
              {
                kind: "query"
                name: "lng"
                orig: "lng"
                reqd: false
                type: "`$NUMBER`"
              }
            ]
          }
          method: "GET"
          orig: "/maps/nextbike-live.json"
          segments: [
            {
              lit: "maps"
            }
            {
              lit: "nextbike-live.json"
            }
          ]
          select: {
            exist: [
              "city"
              "distance"
              "lat"
              "lng"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.countries`"
          }
        }
      ]
    }
  }



}
